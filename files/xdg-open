#!/bin/sh
# Inside the container there is no browser. Wine's winebrowser calls xdg-open,
# so pass the URL to run.sh on the host through a FIFO; run.sh opens http(s)
# links in the host browser and ignores anything else.
[ -p /run/open-url ] || { echo "xdg-open: no host bridge at /run/open-url" >&2; exit 1; }
printf '%s\n' "$1" | timeout 5 tee /run/open-url >/dev/null
